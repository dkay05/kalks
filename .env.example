# =============================================================
# KALKS monorepo - environment overview
# Each app reads its OWN .env.local. This file documents what goes where.
# =============================================================

# ---- apps/web/.env.local (KALKS scaffold site, port 3020) ----
# NEXT_PUBLIC_SITE_URL=http://localhost:3020
# NEXT_PUBLIC_SITE_NAME=KALKS
# Where "Log in", "Open Account" and "Dashboard" buttons send visitors:
# NEXT_PUBLIC_TRADER_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3011

# ---- apps/trader/.env.local (MAIN website, port 3000) ----
# NEXT_PUBLIC_BRAND_NAME=KALKS
# NEXT_PUBLIC_BRAND_SLUG=kalks
# NEXT_PUBLIC_BRAND_DOMAIN=kalks.com
# NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@kalks.com
# GATEWAY_INTERNAL_URL=http://127.0.0.1:8000     # Bullza backend gateway
# NEXT_PUBLIC_WS_URL=ws://localhost:8000          # local dev only

# ---- apps/admin/.env.local (admin panel, port 3011) ----
# NEXT_PUBLIC_BRAND_NAME=KALKS
# GATEWAY_INTERNAL_URL=http://127.0.0.1:8000
# ADMIN_API_PROXY_TARGET=http://127.0.0.1:8001    # Bullza admin API
# NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8001
